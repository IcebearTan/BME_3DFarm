# ── MySQL ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bme_3dfarm
DB_USERNAME=root
DB_PASSWORD=

# ── Redis（Celery broker + 限流 + 缓存）──
REDIS_URL=redis://localhost:6379/0

# ── JWT ──
JWT_SECRET=change-me-in-prod

# ── 邮箱（订单状态通知）──
EMAIL_SERVER=
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ── Bambuddy（打印机底座，仅内网）──
BAMBUDDY_BASE_URL=http://127.0.0.1:8000/api/v1
BAMBUDDY_API_KEY=

# ── 内部 API（给训练营奖励系统预留的 credit 发放接口）──
INTERNAL_API_KEY=change-me

# ── Webhook secret（/internal/webhooks/bambuddy/<secret> 的路径片段）──
WEBHOOK_SECRET=change-me

# ── MinIO（3D 模型文件存储）──
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bme-3dfarm-models
MINIO_SECURE=false
